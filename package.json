{
  "name": "managr",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docs": "bun --cwd website start --port 3001",
    "docs:build": "bun --cwd website build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && bun --cwd website typecheck",
    "db:status": "tsx scripts/databases.ts status",
    "db:demo": "tsx scripts/databases.ts use demo",
    "db:prod": "tsx scripts/databases.ts use production",
    "db:demo:set": "tsx scripts/databases.ts set demo",
    "db:prod:set": "tsx scripts/databases.ts set production",
    "db:prod:init": "tsx scripts/databases.ts init production",
    "docker:restart": "docker compose up --build -d",
    "docker:restart:desk": "docker compose up --build -d desk",
    "docker:rebuild": "docker compose build --no-cache desk && docker compose up -d desk",
    "docker:status": "docker compose ps",
    "docker:logs": "docker compose logs -f desk",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "next": "^15.5.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
